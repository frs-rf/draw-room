# ---- Tambahkan / ubah di .env ----
APP_NAME="Live Draw Kamar"
APP_URL=https://draw.contoh.id
APP_DEBUG=false

# DB cloud (MySQL/MariaDB atau PostgreSQL terkelola). Pilih region yang sama dengan server aplikasi.
DB_CONNECTION=mysql
DB_URL=mysql://USER:PASS@HOST:3306/NAMA_DB
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt   # banyak DB cloud mewajibkan SSL

DRAW_ROOM_SIZE=4

# Realtime (Reverb). Dibuat otomatis oleh install:broadcasting, pastikan ada:
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=draw.contoh.id
REVERB_PORT=443
REVERB_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
